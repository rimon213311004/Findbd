# ─────────────────────────────────────────────────────────────────────────────
# FindBD — API environment
#
# Copy to apps/api/.env and fill in. The process refuses to boot with an invalid
# environment rather than failing mysteriously at runtime — see
# apps/api/src/config/env.ts for the rules each variable must satisfy.
#
# NEVER COMMIT A FILLED-IN COPY. .gitignore excludes .env and .env.*
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Where the browser loads the web app from. Must match exactly: the API sends
# Access-Control-Allow-Credentials, and a wildcard origin is invalid with it.
WEB_ORIGIN=http://localhost:3000


# ───────────────────────────────────────────────────────────────── database ──
# Include the database name. Without it the driver silently uses `test`.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/findbd


# ─────────────────────────────────────────────────────────────────── tokens ──
# Two DIFFERENT secrets, 32+ characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes-base64url
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-48-random-bytes

# Short access token: it lives in browser memory only, so expiry is the main
# limit on what a stolen one is worth.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30


# ──────────────────────────────────────────────────────────────────── images ──
# Report photos. Leave blank to disable image upload entirely — reports still
# work, the uploader is simply unavailable rather than erroring.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_REPORT_FOLDER=findbd/reports


# ─────────────────────────────────────────────────────────────────── matching ──
# Tuning for the Lost↔Found scorer (src/modules/matching/scoring.service.ts).
# The blueprint weights themselves are fixed in @findbd/shared, not here.

# How far apart two reports' dates may be before the date component scores 0.
MATCH_DATE_WINDOW_DAYS=30

# Days of slack allowed for a found date that precedes the lost date. Absorbs
# imprecise user-entered dates; beyond it the pair is disqualified outright.
MATCH_DATE_SLACK_DAYS=1

# Ceiling on candidates scored per report, so one report in a busy category
# cannot turn creation into a table scan.
MATCH_CANDIDATE_LIMIT=300
